  "tables": [
    {
      "id": "igc-d-vc",
      "source": {
        "document": "IGC Code, resolution MSC.370(93), as amended",
        "locator": "2.4.1.1",
        "page": "MSC.370-93.pdf, annex pp. 20-21"
      },
      "input": {
        "name": "Vc",
        "unit": "m3"
      },
      "unit": "m",
      "rows": [
        {
          "when": {
            "le": 1000
          },
          "shape": "const",
          "a": 0.8
        },
        {
          "when": {
            "gt": 1000,
            "lt": 5000
          },
          "shape": "a+v*b/c",
          "a": 0.75,
          "b": 0.2,
          "c": 4000
        },
        {
          "when": {
            "ge": 5000,
            "lt": 30000
          },
          "shape": "a+v/c",
          "a": 0.8,
          "c": 25000
        },
        {
          "when": {
            "ge": 30000
          },
          "shape": "const",
          "a": 2.0
        }
      ]
    },
    {
      "id": "igc-min-thickness",
      "source": {
        "document": "IGC Code, resolution MSC.370(93), as amended",
        "locator": "4.23.2.1.2",
        "page": "MSC.370-93.pdf, annex p. 64"
      },
      "input": {
        "name": "tank material"
      },
      "unit": "mm",
      "rows": [
        {
          "when": {
            "in": [
              "9Ni",
              "S690QL1"
            ]
          },
          "shape": "const",
          "a": 5.0
        },
        {
          "when": {
            "in": [
              "304L",
              "316L"
            ]
          },
          "shape": "const",
          "a": 3.0
        }
      ]
    },
