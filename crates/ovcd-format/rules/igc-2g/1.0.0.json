  "rules": [
    {
      "id": "igc/2.4.1.2/side-clearance",
      "title": "Cargo tank side distance from the outer shell, at least d(Vc) less the insulation",
      "origin": "regulation",
      "source": {
        "document": "IGC Code, resolution MSC.370(93), as amended",
        "edition": "IGC Code as adopted by MSC.370(93), amended by MSC.411(97), MSC.441(99), MSC.476(102), MSC.492(104), MSC.523(106) and MSC.566(109); none changes 2.3, 2.4 or 4.23; MSC.492(104) replaces 2.7.1.1",
        "locator": "2.4.1.2",
        "page": "MSC.370-93.pdf, annex pp. 20-21",
        "access": "free",
        "also": [
          "2.4.1.1",
          "2.4.2"
        ]
      },
      "codified": {
        "by": "agent",
        "date": "2026-10-21",
        "review": "#271"
      },
      "verified": {
        "by": "agent",
        "date": "2026-10-21",
        "edition_held": "MSC.370(93) with MSC.411(97), MSC.441(99), MSC.476(102), MSC.492(104), MSC.523(106) and MSC.566(109); none changes 2.3, 2.4 or 4.23",
        "locator_read": "2.4.1.2 with 2.4.1.1 and 2.4.2, annex pp. 20-21",
        "review": "#271"
      },
      "kind": "formula",
      "measure": {
        "id": "tank.side_gap"
      },
      "compare": "ge",
      "limit": {
        "shape": "less-input",
        "of": {
          "table": "igc-d-vc",
          "at": "tank.vc"
        },
        "less": "tank.insulation",
        "unit": "m"
      },
      "tolerance": 1e-09,
      "consequence": "block",
      "sizes": true,
      "evaluated": true,
      "finding": null,
      "since": "1.0.0"
    },
    {
