{
  "$schema": "../rule-set.schema.json",
  "id": "example",
  "family": "example",
  "title": "Example Rule Set for the loader tests (not a rule book)",
  "version": "1.0.0",
  "edition": {
    "document": "OVCD example: invented numbers, for tests only",
    "edition": "none"
  },
  "sources": [],
  "status": "draft",
  "applies_when": { "cargo_containment": ["type_c_tanks"] },
  "tables": [
    {
      "id": "example-gap",
      "source": { "document": "OVCD example", "locator": "2.1" },
      "input": { "name": "Vc", "unit": "m3" },
      "unit": "m",
      "rows": [
        { "when": { "le": 1000 }, "shape": "const", "a": 0.8 },
        { "when": { "gt": 1000, "lt": 5000 }, "shape": "a+v*b/c", "a": 0.75, "b": 0.2, "c": 4000 },
        { "when": { "ge": 5000 }, "shape": "const", "a": 1.0 }
      ]
    }
  ],
  "rules": [
    {
      "id": "example/1.1/area-0-30",
      "title": "Area under the GZ curve from 0 to 30 degrees",
      "origin": "regulation",
      "source": { "document": "OVCD example", "edition": "none", "locator": "1.1", "page": "none", "access": "free" },
      "codified": { "by": "agent", "date": "2026-10-20", "review": "#268" },
      "verified": false,
      "kind": "limit",
      "measure": { "id": "gz.area", "args": { "from_deg": 0, "to_deg": 30 } },
      "compare": "ge",
      "limit": { "value": 0.055, "unit": "m.rad" },
      "tolerance": 0,
      "consequence": "block",
      "sizes": false,
      "evaluated": true,
      "finding": null,
      "since": "1.0.0"
    },
    {
      "id": "example/2.1/side-gap",
      "title": "Clear side gap of each tank, at least the table value",
      "origin": "regulation",
      "source": { "document": "OVCD example", "edition": "none", "locator": "2.1", "page": "none", "access": "free" },
      "codified": { "by": "agent", "date": "2026-10-20", "review": "#268" },
      "verified": { "by": "agent", "date": "2026-10-20", "edition_held": "OVCD example", "locator_read": "2.1", "review": "#268" },
      "applies_when": { "tank_head_type": ["hemispherical", "torispherical"] },
      "kind": "table",
      "measure": { "id": "tank.side_gap" },
      "compare": "ge",
      "limit": { "table": "example-gap", "at": "tank.vc", "unit": "m" },
      "consequence": "block",
      "sizes": true,
      "evaluated": true,
      "since": "1.0.0"
    },
    {
      "id": "example/2.2/side-gap-less-insulation",
      "title": "Clear side gap, at least the table value less the insulation",
      "origin": "regulation",
      "source": { "document": "OVCD example", "edition": "none", "locator": "2.2", "page": "none", "access": "free" },
      "codified": { "by": "agent", "date": "2026-10-20", "review": "#268" },
      "verified": false,
      "kind": "formula",
      "measure": { "id": "tank.side_gap" },
      "compare": "ge",
      "limit": {
        "shape": "less-input",
        "of": { "table": "example-gap", "at": "tank.vc" },
        "less": "input.tank_insulation_thickness",
        "unit": "m"
      },
      "consequence": "warn",
      "evaluated": true,
      "since": "1.0.0"
    },
    {
      "id": "example/gas-arrangement/weld-factor",
      "title": "Weld factor at most 0.95",
      "origin": "tool-limit",
      "source": {},
      "codified": { "by": "agent", "date": "2026-10-20", "review": "#268" },
      "verified": false,
      "kind": "limit",
      "measure": { "id": "input.weld_factor" },
      "compare": "le",
      "limit": { "value": 0.95, "unit": "1" },
      "consequence": "warn",
      "evaluated": true,
      "since": "1.0.0"
    },
    {
      "id": "example/1.3/weather",
      "title": "Weather criterion",
      "origin": "regulation",
      "source": { "document": "OVCD example", "edition": "none", "locator": "1.3", "page": "none", "access": "free" },
      "codified": { "by": "agent", "date": "2026-10-20", "review": "#268" },
      "verified": false,
      "kind": "check",
      "measure": { "id": "stability.weather" },
      "consequence": "block",
      "evaluated": false,
      "gap": "needs the wind heeling lever",
      "since": "1.0.0"
    },
    {
      "id": "example/1.4/fill-basis",
      "title": "Filling limit basis of the fill ratio",
      "origin": "regulation",
      "source": { "document": "OVCD example", "edition": "none", "locator": "1.4", "page": "none", "access": "free" },
      "codified": { "by": "agent", "date": "2026-10-20", "review": "#268" },
      "verified": false,
      "kind": "note",
      "measure": { "id": "input.fill_ratio" },
      "consequence": "note",
      "evaluated": true,
      "finding": "#282",
      "since": "1.0.0"
    }
  ]
}
