        "args": {
          "condition": "laden"
        }
      },
      "compare": "le",
      "limit": {
        "shape": "clamp",
        "x": "input.length_overall_m",
        "a": 0.0,
        "b": 2.0,
        "c": 1.0,
        "lo": 0.0,
        "hi": 500.0,
        "unit": "m"
      },
      "tolerance": 0,
      "consequence": "warn",
      "sizes": false,
      "evaluated": true,
      "since": "1.0.0",
      "applies_when": {
        "length_band": [
          "45-to-110-m",
          "over-110-m"
        ]
      }
    }
  ]
