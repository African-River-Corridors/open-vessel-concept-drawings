  "includes": [],
  "known_conflicts": [],
  "tables": [],
  "rules": [
    {
      "id": "solas/V.22.1.1/blind-zone-light",
      "title": "The view of the sea surface from the conning position is obscured by no more than two ship lengths or 500 m, whichever is less, ahead of the bow: light condition (it applies to ships of not less than 45 m, read as a length overall of 45 m and more, and to ships built on or after 1 July 1998, which is not modelled; only the distance ahead of the bow is checked, not the 10 degrees on either side or the blind sectors of V/22.1.2)",
      "origin": "regulation",
      "source": {
        "document": "SOLAS 1974 as amended by resolution MSC.99(73)",
        "edition": "MSC.99(73), adopted 5 December 2000",
        "locator": "V.22.1.1",
        "page": "MSC.99-73.pdf, Regulation 22 (annex p. 133)",
        "access": "free"
      },
      "codified": {
        "by": "agent",
        "date": "2026-10-22",
        "review": "#355"
      },
      "verified": false,
      "kind": "formula",
      "measure": {
        "id": "wheelhouse.blind_distance",
        "args": {
          "condition": "light"
        }
      },
      "compare": "le",
      "limit": {
        "shape": "clamp",
        "x": "input.length_overall_m",
        "a": 0.0,
        "b": 2.0,
        "c": 1.0,
        "lo": 0.0,
        "hi": 500.0,
        "unit": "m"
      },
      "tolerance": 0,
      "consequence": "warn",
      "sizes": false,
      "evaluated": true,
      "since": "1.0.0",
      "applies_when": {
        "length_band": [
          "45-to-110-m",
          "over-110-m"
        ]
      }
    },
    {
      "id": "solas/V.22.1.1/blind-zone-laden",
      "title": "The same, laden (it applies to ships of not less than 45 m, read as a length overall of 45 m and more, and to ships built on or after 1 July 1998, which is not modelled; only the distance ahead of the bow is checked, not the 10 degrees on either side or the blind sectors of V/22.1.2)",
      "origin": "regulation",
      "source": {
        "document": "SOLAS 1974 as amended by resolution MSC.99(73)",
        "edition": "MSC.99(73), adopted 5 December 2000",
        "locator": "V.22.1.1",
        "page": "MSC.99-73.pdf, Regulation 22 (annex p. 133)",
        "access": "free"
      },
      "codified": {
        "by": "agent",
        "date": "2026-10-22",
        "review": "#355"
      },
      "verified": false,
      "kind": "formula",
      "measure": {
