  "title": "SOLAS Chapter V, regulation 22: navigation bridge visibility (blind distance ahead of the bow)",
  "version": "1.0.0",
  "edition": {
    "document": "SOLAS 1974 as amended by resolution MSC.99(73), revised Chapter V",
    "edition": "MSC.99(73), adopted 5 December 2000",
    "in_force": "1 July 2002"
  },
  "sources": [
    {
      "document": "Resolution MSC.99(73): adoption of amendments to SOLAS 1974 (revised Chapter V)",
      "edition": "adopted 5 December 2000",
