{
  "$schema": "../rule-set.schema.json",
  "id": "example",
  "family": "example",
  "title": "Example Rule Set for the loader tests (not a rule book)",
  "version": "1.0.0",
  "edition": {
    "document": "OVD example: invented numbers, for tests only",
    "edition": "none"
  },
  "sources": [],
  "status": "draft",
  "applies_when": {
    "cargo_containment": [
      "type_c_tanks"
    ]
  },
  "tables": [
    {
      "id": "example-gm",
      "source": {
        "document": "OVD example",
        "locator": "2.1"
      },
      "input": {
        "name": "angle of maximum GZ",
        "unit": "deg"
      },
      "unit": "m",
      "rows": [
        {
          "when": {
            "le": 20
          },
          "shape": "const",
          "a": 0.3
        },
        {
          "when": {
            "gt": 20,
            "lt": 40
          },
          "shape": "a+v*b/c",
          "a": 0.4,
          "b": -0.01,
          "c": 2
        },
        {
          "when": {
            "ge": 40
          },
          "shape": "a+v/c",
          "a": 0.0,
          "c": 200
        }
      ]
    }
  ],
  "rules": [
    {
      "id": "example/1.1/area-0-30",
      "title": "Area under the GZ curve from 0 to 30 degrees",
      "origin": "regulation",
      "source": {
        "document": "OVD example",
        "edition": "none",
        "locator": "1.1",
        "page": "none",
        "access": "free"
      },
      "codified": {
        "by": "agent",
        "date": "2026-10-20",
        "review": "#268"
      },
      "verified": false,
      "kind": "limit",
      "measure": {
        "id": "gz.area",
        "args": {
          "from_deg": 0,
          "to_deg": 30
        }
      },
      "compare": "ge",
      "limit": {
        "value": 0.055,
        "unit": "m.rad"
      },
      "tolerance": 0,
      "consequence": "block",
      "sizes": false,
      "evaluated": true,
      "finding": null,
      "since": "1.0.0"
    },
    {
      "id": "example/2.1/gm-table",
      "title": "Initial GM, at least the table value at the angle of maximum GZ",
      "origin": "regulation",
      "source": {
        "document": "OVD example",
