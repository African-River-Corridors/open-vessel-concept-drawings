{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OVD",
  "version": "0.3.0",
  "identifier": "org.africanrivercorridors.ovd",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OVD",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#24496c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "publisher": "African River Corridors",
    "shortDescription": "Concept design of inland-waterway vessels",
    "windows": { "nsis": { "installMode": "currentUser" } },
    "macOS": { "signingIdentity": "-" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [
      {
        "ext": ["vdesign"],
        "name": "OVD Design",
        "description": "OVD Design",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/json",
        "exportedType": {
          "identifier": "org.africanrivercorridors.ovd.vdesign",
          "conformsTo": ["public.json"]
        }
      }
    ]
  }
}
