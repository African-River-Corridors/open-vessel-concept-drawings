        "fn": "parse_flat_yaml",
        "args": {
          "text": "# Illustrative rates for the example only — not market quotes; supply your own.\n#\n# Fabrication and supply rates for vessel_designer.core.barge_cost. Every number here is a\n# round placeholder chosen to make the example run. Do not use it for a budget or a bid.\n# Copy this file, put in rates from your own yard quotes, and pass it in:\n#\n#     from vessel_designer.core.barge_cost import BargeCostInputs, compute\n#     result = compute(BargeCostInputs(), rates=\"my_rates.yaml\")\n#\n# Units: \"_rate\" is currency per tonne of the matching mass unless stated; \"_lump\" is per\n# ATB unit (barge + tug); \"yard_margin_fraction\" is a fraction of the barge + tug subtotal.\n\ncurrency: USD\n\n# --- barge fabrication / supply (per tonne) ---\nhull_steel_rate: 2500.0          # fabricated hull structure; also used for the tug hull\ntank_shell_rate: 10000.0         # Type-C pressure-vessel shell and heads\ntank_supports_rate: 2000.0       # saddles, anti-flotation, internals\ninsulation_rate: 4000.0          # installed insulation system, per tonne equivalent\npiping_rate: 4500.0              # piping and machinery\noutfitting_rate: 4000.0\n\n# --- cargo system (lump sums per unit) ---\ncargo_system_lump: 500000.0      # pumps, manifold, ESD, relief, gauging\npaint_anodes_misc: 100000.0\n\n# --- electric pusher tug ---\nbattery_rate_per_kwh: 250.0      # per kWh installed\npropulsion_rate_per_kw: 1000.0   # per kW installed: thrusters, drives, switchboard\nwheelhouse_accom_lump: 450000.0  # wheelhouse, crew spaces, navigation and controls\ntug_outfitting_lump: 200000.0\n\n# --- yard and delivery ---\nyard_margin_fraction: 0.10       # engineering, class, trials, margin\ndelivery_lump: 200000.0          # delivery voyage or heavy-lift, per unit\n"
        }
      }
